#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf '%s\n' 'LOCAL_CONFIG_INVALID' >&2
  exit 64
}

[[ $# -ge 1 ]] || fail
environment_file=${FMONITOR_LOCAL_ENV_FILE:-.env}
[[ -f "$environment_file" && ! -L "$environment_file" ]] || fail

required=(
  COMPOSE_PROJECT_NAME FMONITOR_RUNTIME_IMAGE FMONITOR_HTTP_PORT
  FMONITOR_DB_NAME FMONITOR_DB_USER FMONITOR_DB_PASSWORD
  FMONITOR_MIGRATION_DB_USER FMONITOR_MIGRATION_DB_PASSWORD
  FMONITOR_PROCESS_TABLE_PREFIX FMONITOR_LEGACY_TABLE_PREFIX
  FMONITOR_SESSION_INSTANCE FMONITOR_YII_COOKIE_VALIDATION_KEY
  FMONITOR_YII_IDENTITY_KEY FMONITOR_TRUSTED_REQUEST_HOST
  FMONITOR_TRUSTED_REQUEST_SCHEME FMONITOR_INITIAL_OWNER_EMAIL
  FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD
  FMONITOR_ERP_HOST FMONITOR_ERP_DATABASE FMONITOR_ERP_USER
  FMONITOR_ERP_PASSWORD FMONITOR_ERP_EQUIPMENT_FACTS_HMAC_KEY
  FMONITOR_ERP_EQUIPMENT_FACTS_TIMEOUT_SECONDS
  FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE
  FMONITOR_RUNTIME_ENV FMONITOR_PUBLIC_BASE_URL
  FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID
  FMONITOR_SMTP_HOST FMONITOR_SMTP_PORT FMONITOR_SMTP_ENCRYPTION
  FMONITOR_SMTP_USERNAME FMONITOR_SMTP_PASSWORD FMONITOR_SMTP_FROM_ADDRESS
  FMONITOR_SMTP_FROM_NAME FMONITOR_SMTP_TIMEOUT_SECONDS FMONITOR_SMTP_VERIFY_PEER
)
integration=(
  FMONITOR_SOURCE_HOST FMONITOR_SOURCE_PORT FMONITOR_SOURCE_NAME
  FMONITOR_SOURCE_USER FMONITOR_SOURCE_PASSWORD FMONITOR_MIGRATION_CUTOFF
  FMONITOR_BITRIX_WEBHOOK_URL FMONITOR_BITRIX_DEPARTMENT_IDS_JSON
)
optional=(FMONITOR_BITRIX_CA_FILE_HOST FMONITOR_SMTP_TEST_RECIPIENT)
for name in "${required[@]}" "${integration[@]}" "${optional[@]}"; do unset "$name"; done
seen='|'
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" || "$line" == \#* ]] && continue
  [[ "$line" == *=* ]] || fail
  name=${line%%=*}
  value=${line#*=}
  [[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || fail
  case " ${required[*]} " in
    *" $name "*) ;;
    *)
      case " ${integration[*]} " in
        *" $name "*) continue ;;
        *)
          case " ${optional[*]} " in
            *" $name "*) ;;
            *) fail ;;
          esac
          ;;
      esac
      ;;
  esac
  [[ "$seen" != *"|$name|"* ]] || fail
  seen+="$name|"
  export "$name=$value"
done < "$environment_file"

for name in "${required[@]}"; do
  [[ "$seen" == *"|$name|"* ]] || fail
  value=${!name}
  [[ -n "$value" && "$value" != *replace_me* && "$value" != replace_with_* ]] || fail
done

project=$COMPOSE_PROJECT_NAME
[[ "$project" =~ ^fm2-local-[A-Za-z0-9_-]+$ ]] || fail
project_words="-${project#fm2-local-}-"
case "$project_words" in
  *-prod-*|*-production-*|*-stage-*|*-staging-*|*-live-*) fail ;;
esac
port=$FMONITOR_HTTP_PORT
[[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || fail
(( ${#FMONITOR_YII_COOKIE_VALIDATION_KEY} >= 32 )) || fail
(( ${#FMONITOR_YII_IDENTITY_KEY} >= 32 )) || fail
[[ "$FMONITOR_TRUSTED_REQUEST_SCHEME" == http || "$FMONITOR_TRUSTED_REQUEST_SCHEME" == https ]] || fail
[[ "$FMONITOR_TRUSTED_REQUEST_HOST" == *:* ]] || fail
[[ "$FMONITOR_INITIAL_OWNER_EMAIL" == *@*.* ]] || fail
[[ "$FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID" =~ ^[1-9][0-9]*$ ]] || fail
(( ${#FMONITOR_ERP_EQUIPMENT_FACTS_HMAC_KEY} >= 32 )) || fail
[[ "$FMONITOR_ERP_EQUIPMENT_FACTS_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] && (( FMONITOR_ERP_EQUIPMENT_FACTS_TIMEOUT_SECONDS >= 1 && FMONITOR_ERP_EQUIPMENT_FACTS_TIMEOUT_SECONDS <= 60 )) || fail
[[ "$FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS" =~ ^[0-9]+$ ]] && (( FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS >= 1 && FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS <= 10000 )) || fail
[[ "$FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE" =~ ^[0-9]+$ ]] && (( FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE >= 1 && FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE <= 500 && FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE <= FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS )) || fail
php -r 'require "app/autoload.php"; FMonitor2\Jobs\SmtpConfiguration::fromEnvironment(getenv());' >/dev/null 2>&1 || fail

if [[ $# -eq 1 && $1 == --validate ]]; then
  exit 0
fi
[[ $1 == -- ]] || fail
shift
[[ $# -gt 0 ]] || fail

arguments=()
for argument in "$@"; do
  case "$argument" in
    @env:*)
      name=${argument#@env:}
      [[ "$seen" == *"|$name|"* ]] || fail
      arguments+=("${!name}")
      ;;
    @optional-volume:*)
      value=${argument#@optional-volume:}
      name=${value%%:*}
      target=${value#*:}
      if [[ "$seen" == *"|$name|"* && -n "${!name}" ]]; then
        arguments+=(--volume "${!name}:$target")
      fi
      ;;
    @optional-environment:*)
      value=${argument#@optional-environment:}
      name=${value%%:*}
      assignment=${value#*:}
      if [[ "$seen" == *"|$name|"* && -n "${!name}" ]]; then
        arguments+=(--env "$assignment")
      fi
      ;;
    @local-url*)
      arguments+=("http://127.0.0.1:${FMONITOR_HTTP_PORT}${argument#@local-url}")
      ;;
    @trusted-host-header)
      arguments+=("Host: ${FMONITOR_TRUSTED_REQUEST_HOST}")
      ;;
    @env-file)
      arguments+=("$environment_file")
      ;;
    *) arguments+=("$argument") ;;
  esac
done
exec "${arguments[@]}"
