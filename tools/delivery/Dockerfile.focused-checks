ARG PHP_IMAGE
ARG PHP_IMAGE_DIGEST
ARG NODE_VERSION
ARG NODE_BOOKWORM_IMAGE_DIGEST
ARG PYTHON_VERSION
ARG PYTHON_IMAGE_DIGEST
ARG COMPOSER_VERSION
ARG COMPOSER_IMAGE_DIGEST
ARG UV_VERSION
ARG UV_IMAGE_DIGEST
ARG SHLZ_UI_REVISION
ARG COMPOSER_LOCK_SHA256

FROM node:${NODE_VERSION}-bookworm-slim@${NODE_BOOKWORM_IMAGE_DIGEST} AS node

FROM node AS shlz-ui
ARG SHLZ_UI_REVISION
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/Antropophag/shlz-ui.git /shlz-ui \
    && git -C /shlz-ui checkout --detach "$SHLZ_UI_REVISION" \
    && rm -rf /shlz-ui/.git \
    && npm --prefix /shlz-ui ci \
    && node -e 'const fs=require("fs"),p="/shlz-ui/node_modules/playwright-core/package.json",v=require(p);v.exports["./browsers.json"]="./browsers.json";fs.writeFileSync(p,JSON.stringify(v))' \
    && PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
        node /shlz-ui/node_modules/playwright/cli.js install chromium

FROM python:${PYTHON_VERSION}-bookworm@${PYTHON_IMAGE_DIGEST} AS python
FROM composer:${COMPOSER_VERSION}@${COMPOSER_IMAGE_DIGEST} AS composer
FROM ghcr.io/astral-sh/uv:${UV_VERSION}@${UV_IMAGE_DIGEST} AS uv

FROM ${PHP_IMAGE}@${PHP_IMAGE_DIGEST} AS common
ARG COMPOSER_LOCK_SHA256

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash git make unzip \
    && docker-php-ext-install -j"$(nproc)" mysqli pcntl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/ /usr/local/
COPY --from=python /usr/local/ /usr/local/
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
COPY --from=uv /uv /uvx /usr/local/bin/
COPY composer.json composer.lock /workspace/
RUN composer install --working-dir=/workspace --no-interaction --no-scripts
COPY pyproject.toml uv.lock /opt/fmonitor/
RUN UV_PROJECT_ENVIRONMENT=/opt/fmonitor/.venv \
        uv sync --directory=/opt/fmonitor --frozen --no-install-project

LABEL org.fmonitor.composer-lock-sha256="$COMPOSER_LOCK_SHA256"

ENV NODE_PATH=/shlz-ui/node_modules \
    FMONITOR_SHLZ_UI_ROOT=/shlz-ui \
    FMONITOR_COMPOSER_VENDOR=/workspace/vendor \
    FMONITOR_PYTHON_ENV=/opt/fmonitor/.venv
WORKDIR /workspace

FROM common AS governance
ENV FMONITOR_PROFILE=governance

FROM common AS integration
ENV FMONITOR_PROFILE=integration

FROM common AS browser
COPY --from=shlz-ui /shlz-ui /shlz-ui
COPY --from=shlz-ui /ms-playwright /ms-playwright
ENV FMONITOR_PROFILE=browser \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
