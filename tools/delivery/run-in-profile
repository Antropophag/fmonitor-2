#!/usr/bin/env bash
set -u

usage() {
    echo 'usage: run-in-profile <governance|integration|browser> <command> [args...]' >&2
    exit 2
}

[[ $# -ge 2 ]] || usage
profile=$1
shift
case "$profile" in
    governance|integration|browser) ;;
    *) usage ;;
esac

root=$(git -C "$(dirname "$0")/../.." rev-parse --show-toplevel) || exit 2
execution_tmp=$(mktemp -d "${TMPDIR:-/tmp}/fmonitor-profile.XXXXXXXX") || exit 2
materialized=$execution_tmp/source
cleanup() {
    if [[ -d "$materialized" ]]; then
        git -C "$root" worktree remove --force "$materialized" >/dev/null 2>&1 || true
    fi
    rm -rf -- "$execution_tmp"
}
trap cleanup EXIT HUP INT TERM

source_digest() {
    local source_root=$1
    (
        cd "$source_root" || exit 2
        python3 -c 'import importlib.util, pathlib
p = pathlib.Path("tools/delivery/harness.py").resolve()
s = importlib.util.spec_from_file_location("candidate_harness", p)
m = importlib.util.module_from_spec(s)
s.loader.exec_module(m)
print(m.source_details()["executable_digest"])'
    )
}

expected_source=
snapshot=${FMONITOR_EXECUTION_SNAPSHOT:-}
if [[ -z "$snapshot" ]]; then
    snapshot=$execution_tmp/snapshot
    expected_source=$(source_digest "$root") || exit 2
    python3 "$root/tools/delivery/review-source.py" capture \
        --repo "$root" --output "$snapshot" >/dev/null || exit 2
fi
python3 "$root/tools/delivery/review-source.py" restore \
    --snapshot "$snapshot" --output "$materialized" >/dev/null || exit 2
executable_source=$(source_digest "$materialized") || exit 2
if [[ -n "$expected_source" && "$executable_source" != "$expected_source" ]]; then
    echo 'materialized executable source does not match frozen candidate' >&2
    exit 2
fi

set -a
# shellcheck source=dependencies.env
. "$materialized/tools/delivery/dependencies.env"
set +a

recipe=$materialized/tools/delivery/Dockerfile.focused-checks
recipe_hash=$(sha256sum "$recipe" "$materialized/tools/delivery/dependencies.env" \
    "$materialized/composer.json" "$materialized/composer.lock" \
    "$materialized/tools/delivery/Dockerfile.focused-checks.dockerignore" \
    <(printf '%s' "$executable_source") \
    | sha256sum | cut -c1-16)
image="fmonitor2-focused-${profile}:${recipe_hash}"
git_sha=$(git -C "$materialized" rev-parse HEAD) || exit 2
composer_lock_sha=$(sha256sum "$materialized/composer.lock" | cut -d' ' -f1) || exit 2

docker build --quiet --target "$profile" --tag "$image" \
    --label "org.opencontainers.image.revision=$git_sha" \
    --build-arg "COMPOSER_LOCK_SHA256=$composer_lock_sha" \
    --build-arg "EXECUTABLE_SOURCE=$executable_source" \
    --build-arg "PHP_IMAGE=$PHP_IMAGE" \
    --build-arg "PHP_IMAGE_DIGEST=$PHP_IMAGE_DIGEST" \
    --build-arg "NODE_VERSION=$NODE_VERSION" \
    --build-arg "NODE_BOOKWORM_IMAGE_DIGEST=$NODE_BOOKWORM_IMAGE_DIGEST" \
    --build-arg "PYTHON_VERSION=$PYTHON_VERSION" \
    --build-arg "PYTHON_IMAGE_DIGEST=$PYTHON_IMAGE_DIGEST" \
    --build-arg "COMPOSER_VERSION=$COMPOSER_VERSION" \
    --build-arg "COMPOSER_IMAGE_DIGEST=$COMPOSER_IMAGE_DIGEST" \
    --build-arg "UV_VERSION=$UV_VERSION" \
    --build-arg "UV_IMAGE_DIGEST=$UV_IMAGE_DIGEST" \
    --build-arg "SHLZ_UI_REVISION=$SHLZ_UI_REVISION" \
    --file "$recipe" "$materialized" >/dev/null || exit $?
image_digest=$(docker image inspect "$image" --format '{{.Id}}') || exit 2
image_lock_sha=$(docker image inspect "$image_digest" \
    --format '{{index .Config.Labels "org.fmonitor.composer-lock-sha256"}}') || exit 2
image_source=$(docker image inspect "$image_digest" \
    --format '{{index .Config.Labels "org.fmonitor.executable-source"}}') || exit 2
if [[ "$image_lock_sha" != "$composer_lock_sha" || "$image_source" != "$executable_source" ]]; then
    echo 'container dependency/source identity does not match frozen candidate' >&2
    exit 2
fi

profile_run_args=()
if [[ "$profile" == integration || "$profile" == browser ]]; then
    network_name=$(
        cd "$root" || exit 2
        docker compose -f compose.test.yaml config --format json |
            python3 -c 'import json, sys
try:
    value = json.load(sys.stdin).get("networks", {}).get("default", {}).get("name")
    if isinstance(value, str) and value:
        print(value)
except (AttributeError, json.JSONDecodeError):
    pass'
    )
    if [[ -n "$network_name" ]] && docker network inspect "$network_name" >/dev/null 2>&1; then
        profile_run_args+=(
            --network "$network_name"
            --env FMONITOR_TEST_DB_HOST=test-db
            --env FMONITOR_TEST_DB_PORT=3306
        )
    fi
fi

started=$(python3 -c 'import time; print(time.time_ns())')
docker run --rm --init \
    ${profile_run_args[@]+"${profile_run_args[@]}"} \
    --read-only \
    --tmpfs /tmp:rw,nosuid,nodev \
    --tmpfs /workspace/.local:rw,nosuid,nodev \
    --env "FMONITOR_IMAGE_DIGEST=$image_digest" \
    --env "FMONITOR_EXECUTED_SOURCE=$executable_source" \
    --env "FMONITOR_EXECUTED_GIT_SHA=$git_sha" \
    --workdir /workspace \
    "$image_digest" sh -c \
        'test -r /workspace/vendor/autoload.php \
            && test -r /workspace/vendor/yiisoft/yii2/Yii.php \
            && exec "$@"' \
        run-in-profile "$@"
status=$?
finished=$(python3 -c 'import time; print(time.time_ns())')

python3 - "$git_sha" "$profile" "$image_digest" "$executable_source" "$status" "$started" "$finished" "$@" <<'PY' >&2
import json, sys
git_sha, profile, image, source, status, started, finished, *argv = sys.argv[1:]
print("RUN_IN_PROFILE_RESULT " + json.dumps({
    "argv": argv,
    "duration_seconds": (int(finished) - int(started)) / 1_000_000_000,
    "exit_code": int(status),
    "git_sha": git_sha,
    "image_digest": image,
    "profile": profile,
    "source_digest": source,
}, separators=(",", ":"), sort_keys=True))
PY
exit "$status"
