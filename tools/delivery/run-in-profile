#!/usr/bin/env bash
set -u

usage() {
    echo 'usage: run-in-profile <governance|integration|browser> <command> [args...]' >&2
    exit 2
}

[[ $# -ge 2 ]] || usage
profile=$1
shift
case "$profile" in
    governance|integration|browser) ;;
    *) usage ;;
esac

root=$(git -C "$(dirname "$0")/../.." rev-parse --show-toplevel) || exit 2
set -a
# shellcheck source=dependencies.env
. "$root/tools/delivery/dependencies.env"
set +a

recipe=$root/tools/delivery/Dockerfile.focused-checks
recipe_hash=$(sha256sum "$recipe" "$root/tools/delivery/dependencies.env" \
    | sha256sum | cut -c1-16)
image="fmonitor2-focused-${profile}:${recipe_hash}"
git_sha=$(git -C "$root" rev-parse HEAD) || exit 2

docker build --quiet --target "$profile" --tag "$image" \
    --label "org.opencontainers.image.revision=$git_sha" \
    --build-arg "PHP_IMAGE=$PHP_IMAGE" \
    --build-arg "PHP_IMAGE_DIGEST=$PHP_IMAGE_DIGEST" \
    --build-arg "NODE_VERSION=$NODE_VERSION" \
    --build-arg "NODE_BOOKWORM_IMAGE_DIGEST=$NODE_BOOKWORM_IMAGE_DIGEST" \
    --build-arg "PYTHON_VERSION=$PYTHON_VERSION" \
    --build-arg "PYTHON_IMAGE_DIGEST=$PYTHON_IMAGE_DIGEST" \
    --build-arg "COMPOSER_VERSION=$COMPOSER_VERSION" \
    --build-arg "COMPOSER_IMAGE_DIGEST=$COMPOSER_IMAGE_DIGEST" \
    --build-arg "UV_VERSION=$UV_VERSION" \
    --build-arg "UV_IMAGE_DIGEST=$UV_IMAGE_DIGEST" \
    --build-arg "SHLZ_UI_REVISION=$SHLZ_UI_REVISION" \
    --file "$recipe" "$root" >/dev/null || exit $?
image_digest=$(docker image inspect "$image" --format '{{.Id}}') || exit 2

profile_run_args=()
if [[ "$profile" == integration || "$profile" == browser ]]; then
    network_name=$(
        cd "$root" || exit 2
        docker compose -f compose.test.yaml config --format json |
            python3 -c 'import json, sys
try:
    value = json.load(sys.stdin).get("networks", {}).get("default", {}).get("name")
    if isinstance(value, str) and value:
        print(value)
except (AttributeError, json.JSONDecodeError):
    pass'
    )
    if [[ -n "$network_name" ]] && docker network inspect "$network_name" >/dev/null 2>&1; then
        profile_run_args+=(
            --network "$network_name"
            --env FMONITOR_TEST_DB_HOST=test-db
            --env FMONITOR_TEST_DB_PORT=3306
        )
    fi
fi

started=$(python3 -c 'import time; print(time.time_ns())')
observation_dir=$(mktemp -d "${TMPDIR:-/tmp}/fmonitor-profile-observation.XXXXXX") || exit 2
observation_stdout=$observation_dir/stdout
observation_stderr=$observation_dir/stderr
trap 'rm -rf "$observation_dir"' EXIT
docker run --rm --init \
    ${profile_run_args[@]+"${profile_run_args[@]}"} \
    --env "FMONITOR_IMAGE_DIGEST=$image_digest" \
    --mount "type=bind,src=$root,dst=/workspace" \
    --workdir /workspace \
    "$image_digest" "$@" >"$observation_stdout" 2>"$observation_stderr"
status=$?
finished=$(python3 -c 'import time; print(time.time_ns())')
cat "$observation_stdout"
cat "$observation_stderr" >&2

python3 - "$git_sha" "$profile" "$image_digest" "$status" "$started" "$finished" \
    "$observation_stdout" "$observation_stderr" "$@" <<'PY' >&2
import json, pathlib, sys
git_sha, profile, image, status, started, finished, stdout_path, stderr_path, *argv = sys.argv[1:]
stdout = pathlib.Path(stdout_path).read_bytes()
stderr = pathlib.Path(stderr_path).read_bytes()
print("RUN_IN_PROFILE_RESULT " + json.dumps({
    "argv": argv,
    "duration_seconds": (int(finished) - int(started)) / 1_000_000_000,
    "exit_code": int(status),
    "git_sha": git_sha,
    "image_digest": image,
    "observation": {
        "stderr_bytes": len(stderr),
        "stdout_bytes": len(stdout),
    },
    "profile": profile,
}, separators=(",", ":"), sort_keys=True))
PY
exit "$status"
