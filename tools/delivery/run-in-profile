#!/usr/bin/env bash
set -u

usage() {
    echo 'usage: run-in-profile <governance|integration|browser> [--with-services] <command> [args...]' >&2
    exit 2
}

[[ $# -ge 2 ]] || usage
profile=$1
shift
case "$profile" in
    governance|integration|browser) ;;
    *) usage ;;
esac
with_services=false
if [[ "${1:-}" == "--with-services" ]]; then
    with_services=true
    shift
fi
[[ $# -ge 1 ]] || usage

root=$(git -C "$(dirname "$0")/../.." rev-parse --show-toplevel) || exit 2
execution_tmp=$(mktemp -d "${TMPDIR:-/tmp}/fmonitor-profile.XXXXXXXX") || exit 2
materialized=$execution_tmp/source
compose_project=
compose_owned=false
cleanup() {
    if [[ "$compose_owned" == true && -n "$compose_project" && -d "$materialized" ]]; then
        docker compose --project-name "$compose_project" -f "$materialized/compose.test.yaml" \
            down --volumes >/dev/null 2>&1 || true
    fi
    if [[ -d "$materialized" ]]; then
        git -C "$root" worktree remove --force "$materialized" >/dev/null 2>&1 || true
    fi
    rm -rf -- "$execution_tmp"
}
trap cleanup EXIT HUP INT TERM

setup_failure() {
    echo "SETUP_FAILURE: stage=$1" >&2
    exit "${2:-2}"
}

if [[ "$with_services" == true ]]; then
    docker version >/dev/null 2>&1 || setup_failure docker
fi

source_digest() {
    local source_root=$1
    (
        cd "$source_root" || exit 2
        python3 -c 'import importlib.util, pathlib
p = pathlib.Path("tools/delivery/harness.py").resolve()
s = importlib.util.spec_from_file_location("candidate_harness", p)
m = importlib.util.module_from_spec(s)
s.loader.exec_module(m)
print(m.source_details()["executable_digest"])'
    )
}

expected_source=
snapshot=${FMONITOR_EXECUTION_SNAPSHOT:-}
if [[ -z "$snapshot" ]]; then
    snapshot=$execution_tmp/snapshot
    expected_source=$(source_digest "$root") || exit 2
    python3 "$root/tools/delivery/review-source.py" capture \
        --repo "$root" --output "$snapshot" >/dev/null || exit 2
fi
python3 "$root/tools/delivery/review-source.py" restore \
    --snapshot "$snapshot" --output "$materialized" >/dev/null || exit 2
executable_source=$(source_digest "$materialized") || exit 2
if [[ -n "$expected_source" && "$executable_source" != "$expected_source" ]]; then
    echo 'materialized executable source does not match frozen candidate' >&2
    exit 2
fi

set -a
# shellcheck source=dependencies.env
. "$materialized/tools/delivery/dependencies.env"
set +a

recipe=$materialized/tools/delivery/Dockerfile.focused-checks
recipe_hash=$(python3 - "$materialized" <<'PY'
import hashlib, pathlib, sys
root = pathlib.Path(sys.argv[1])
digest = hashlib.sha256()
for relative in (
    "tools/delivery/Dockerfile.focused-checks",
    "tools/delivery/Dockerfile.focused-checks.dockerignore",
    "tools/delivery/dependencies.env",
    "composer.json", "composer.lock", "pyproject.toml", "uv.lock",
):
    digest.update(relative.encode())
    digest.update(b"\0")
    digest.update((root / relative).read_bytes())
    digest.update(b"\0")
print(digest.hexdigest()[:16])
PY
) || exit 2
image="fmonitor2-focused-${profile}:${recipe_hash}"
git_sha=$(git -C "$materialized" rev-parse HEAD) || exit 2
composer_lock_sha=$(sha256sum "$materialized/composer.lock" | cut -d' ' -f1) || exit 2

build_command=(docker buildx build --builder fmonitor2-focused --load --tag "$image" \
        --label "org.fmonitor.owner=focused-checks" \
        --label "org.fmonitor.profile=$profile" \
        --label "org.fmonitor.dependency-digest=$recipe_hash" \
        --build-arg "COMPOSER_LOCK_SHA256=$composer_lock_sha" \
        --build-arg "PHP_IMAGE=$PHP_IMAGE" \
        --build-arg "PHP_IMAGE_DIGEST=$PHP_IMAGE_DIGEST" \
        --build-arg "NODE_VERSION=$NODE_VERSION" \
        --build-arg "NODE_BOOKWORM_IMAGE_DIGEST=$NODE_BOOKWORM_IMAGE_DIGEST" \
        --build-arg "PYTHON_VERSION=$PYTHON_VERSION" \
        --build-arg "PYTHON_IMAGE_DIGEST=$PYTHON_IMAGE_DIGEST" \
        --build-arg "COMPOSER_VERSION=$COMPOSER_VERSION" \
        --build-arg "COMPOSER_IMAGE_DIGEST=$COMPOSER_IMAGE_DIGEST" \
        --build-arg "UV_VERSION=$UV_VERSION" \
        --build-arg "UV_IMAGE_DIGEST=$UV_IMAGE_DIGEST" \
        --build-arg "SHLZ_UI_REVISION=$SHLZ_UI_REVISION" \
        --file "$recipe" "$materialized")
"$materialized/tools/delivery/docker-storage-guard" build \
    --profile "$profile" --image "$image" --dependency-digest "$recipe_hash" \
    --lock-path "${FMONITOR_DOCKER_STORAGE_LOCK_PATH:-${TMPDIR:-/tmp}/fmonitor2-focused-storage.lock}" \
    -- "${build_command[@]}" >/dev/null || setup_failure dependencies "$?"
image_digest=$(docker image inspect --format '{{.Id}}' "$image") || exit 2

profile_run_args=()
if [[ "$with_services" == true ]]; then
    compose_project="fmonitor2-focused-$(python3 -c 'import secrets; print(secrets.token_hex(8))')"
    compose_owned=true
    export FMONITOR_TEST_DB_PORT=0
    docker compose --project-name "$compose_project" -f "$materialized/compose.test.yaml" \
        up --detach --wait test-db || setup_failure db_start "$?"
    docker compose --project-name "$compose_project" -f "$materialized/compose.test.yaml" \
        exec -T test-db mariadb-admin ping --silent -h 127.0.0.1 \
        || setup_failure db_readiness "$?"
    network_name=$(
        cd "$materialized" || exit 2
        docker compose --project-name "$compose_project" -f compose.test.yaml config --format json |
            python3 -c 'import json, sys
try:
    value = json.load(sys.stdin).get("networks", {}).get("default", {}).get("name")
    if isinstance(value, str) and value:
        print(value)
except (AttributeError, json.JSONDecodeError):
    pass'
    )
    [[ -n "$network_name" ]] || setup_failure db_readiness
    docker network inspect "$network_name" >/dev/null 2>&1 || setup_failure db_readiness
    profile_run_args+=(
        --network "$network_name"
        --env FMONITOR_TEST_DB_HOST=test-db
        --env FMONITOR_TEST_DB_PORT=3306
    )
elif [[ "$profile" == integration || "$profile" == browser ]]; then
    network_name=$(
        cd "$materialized" || exit 2
        docker compose -f compose.test.yaml config --format json |
            python3 -c 'import json, sys
try:
    value = json.load(sys.stdin).get("networks", {}).get("default", {}).get("name")
    if isinstance(value, str) and value:
        print(value)
except (AttributeError, json.JSONDecodeError):
    pass'
    )
    if [[ -n "$network_name" ]] && docker network inspect "$network_name" >/dev/null 2>&1; then
        profile_run_args+=(
            --network "$network_name"
            --env FMONITOR_TEST_DB_HOST=test-db
            --env FMONITOR_TEST_DB_PORT=3306
        )
    fi
fi

artifact_run_args=(--tmpfs /workspace/.local:rw,nosuid,nodev)
if [[ -d "$root/.local" ]]; then
    artifact_run_args=(--mount "type=bind,src=$root/.local,dst=/workspace/.local")
fi

started=$(python3 -c 'import time; print(time.time_ns())')
child_stdout=$execution_tmp/child.stdout
docker run --rm --init \
    ${profile_run_args[@]+"${profile_run_args[@]}"} \
    --mount "type=bind,src=$materialized,dst=/workspace,readonly" \
    ${artifact_run_args[@]+"${artifact_run_args[@]}"} \
    --read-only \
    --tmpfs /tmp:rw,nosuid,nodev \
    --tmpfs /workspace/vendor:rw,nosuid,nodev \
    --tmpfs /workspace/.test-artifacts:rw,nosuid,nodev \
    --env "FMONITOR_IMAGE_DIGEST=$image_digest" \
    --env "FMONITOR_EXECUTED_SOURCE=$executable_source" \
    --env "FMONITOR_EXECUTED_GIT_SHA=$git_sha" \
    --env "FMONITOR_SHLZ_CSS_PATH=/shlz-ui/packages/styles/dist/shlz.css" \
    --env "FMONITOR_TEST_PLAYWRIGHT_MODULE=/shlz-ui/node_modules/playwright" \
    --workdir /workspace \
    "$image_digest" sh -c \
        'cp -a /opt/fmonitor/composer/vendor/. /workspace/vendor/ \
            && test -r /workspace/vendor/autoload.php \
            && test -r /workspace/vendor/yiisoft/yii2/Yii.php \
            && exec "$@"' \
        run-in-profile "$@" >"$child_stdout"
status=$?
cat "$child_stdout"
if [[ "$status" -ne 0 ]]; then
    cat "$child_stdout" >&2
fi
finished=$(python3 -c 'import time; print(time.time_ns())')

python3 - "$git_sha" "$profile" "$image_digest" "$executable_source" "$status" "$started" "$finished" "$@" <<'PY' >&2
import json, sys
git_sha, profile, image, source, status, started, finished, *argv = sys.argv[1:]
print("RUN_IN_PROFILE_RESULT " + json.dumps({
    "argv": argv,
    "duration_seconds": (int(finished) - int(started)) / 1_000_000_000,
    "exit_code": int(status),
    "git_sha": git_sha,
    "image_digest": image,
    "profile": profile,
    "source_digest": source,
}, separators=(",", ":"), sort_keys=True))
PY
exit "$status"
