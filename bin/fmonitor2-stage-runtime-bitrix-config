#!/bin/sh
set -eu

fail() {
    printf '%s\n' 'RUNTIME_SECRET_STAGING_FAILED' >&2
    exit 74
}

source_path=/run/fmonitor-input/bitrix-config.json
target_path=/run/fmonitor-secrets/bitrix-config.json
[ -f "$source_path" ] && [ ! -L "$source_path" ] || fail

php -r 'require "app/autoload.php"; FMonitor2\Workforce\WorkerConfiguration::fromFile($argv[1]);' "$source_path" >/dev/null 2>&1 || fail

umask 077
temporary=$(mktemp /run/fmonitor-secrets/.bitrix-config.XXXXXX) || fail
cleanup() {
    [ -z "$temporary" ] || rm -f -- "$temporary"
}
trap cleanup EXIT
cp -- "$source_path" "$temporary" || fail
sync -f "$temporary" || fail
chown 10001:10001 "$temporary" || fail
chmod 0600 "$temporary" || fail
mv -f -- "$temporary" "$target_path" || fail
temporary=
trap - EXIT
