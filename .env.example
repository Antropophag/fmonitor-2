# Canonical local Yii2 runtime. Copy to .env and replace every replace_me value.
# Keep one unique fm2-local-* project name across up/down/logs/ps/reset.
COMPOSE_PROJECT_NAME=fm2-local-replace_me
FMONITOR_RUNTIME_IMAGE=fmonitor2-runtime:local
FMONITOR_HTTP_PORT=8093

FMONITOR_DB_NAME=fmonitor2
FMONITOR_DB_USER=fmonitor_runtime
FMONITOR_DB_PASSWORD=replace_me
FMONITOR_MIGRATION_DB_USER=root
FMONITOR_MIGRATION_DB_PASSWORD=replace_me
FMONITOR_PROCESS_TABLE_PREFIX=fm2_
FMONITOR_LEGACY_TABLE_PREFIX=fm2_

FMONITOR_SESSION_INSTANCE=local
FMONITOR_YII_COOKIE_VALIDATION_KEY=replace_me
FMONITOR_YII_IDENTITY_KEY=replace_me
FMONITOR_TRUSTED_REQUEST_HOST=127.0.0.1:8093
FMONITOR_TRUSTED_REQUEST_SCHEME=http

# Weekly FKR email. Keep SMTP password in a private environment file, never Git.
FMONITOR_RUNTIME_ENV=development
FMONITOR_PUBLIC_BASE_URL=https://fmonitor.example.invalid
FMONITOR_SMTP_HOST=smtp.example.invalid
FMONITOR_SMTP_PORT=587
FMONITOR_SMTP_ENCRYPTION=tls
FMONITOR_SMTP_USERNAME=fmonitor@example.invalid
FMONITOR_SMTP_PASSWORD=replace_me
FMONITOR_SMTP_FROM_ADDRESS=fmonitor@example.invalid
FMONITOR_SMTP_FROM_NAME=FMonitor
FMONITOR_SMTP_TIMEOUT_SECONDS=10
FMONITOR_SMTP_VERIFY_PEER=true

# Replace with the real corporate email of the first owner.
FMONITOR_INITIAL_OWNER_EMAIL=replace_me@shlz.ru
FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD=replace_me

# Local integration inputs. Make stages these into private .local files.
FMONITOR_SOURCE_HOST=legacy-db.example.invalid
FMONITOR_SOURCE_PORT=3306
FMONITOR_SOURCE_NAME=fmonitor
FMONITOR_SOURCE_USER=readonly
FMONITOR_SOURCE_PASSWORD=replace_me
FMONITOR_MIGRATION_CUTOFF=
FMONITOR_BITRIX_WEBHOOK_URL='https://example.invalid/rest/1/replace_me/'
FMONITOR_BITRIX_DEPARTMENT_IDS_JSON='[101,102]'

# Read-only equipment facts source. Real pilot values stay only in ignored .env.
FMONITOR_ERP_HOST=erp.example.invalid
FMONITOR_ERP_DATABASE=1c-erp
FMONITOR_ERP_USER=readonly
FMONITOR_ERP_PASSWORD=replace_me
FMONITOR_ERP_EQUIPMENT_FACTS_HMAC_KEY=replace_me
FMONITOR_ERP_EQUIPMENT_FACTS_TIMEOUT_SECONDS=30
FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS=500
FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE=100
