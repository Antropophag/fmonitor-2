# Read-only connection to the legacy production MariaDB.
# Copy this file to .env and replace the credentials locally.
FMONITOR_SOURCE_HOST=host.docker.internal
FMONITOR_SOURCE_PORT=13306
FMONITOR_SOURCE_NAME=c1_fmonitor
FMONITOR_SOURCE_USER=replace_with_read_only_user
FMONITOR_SOURCE_PASSWORD=replace_with_read_only_password

# Optional. Leave empty to use the end of the current day.
FMONITOR_MIGRATION_CUTOFF=
