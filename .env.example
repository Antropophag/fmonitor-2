# Copy this file to .env and replace the credentials locally.
# The source connection below is only for make import-production, not make up.
FMONITOR_SOURCE_HOST=10.178.69.3
FMONITOR_SOURCE_PORT=3306
FMONITOR_SOURCE_NAME=c1_fmonitor
FMONITOR_SOURCE_USER=replace_with_read_only_user
FMONITOR_SOURCE_PASSWORD=replace_with_read_only_password

# Optional. Leave empty to use the end of the current day.
FMONITOR_MIGRATION_CUTOFF=

# Comma-separated local accounts bootstrapped add-only as User + Superadministrator.
FMONITOR_BOOTSTRAP_SUPERADMIN_EMAILS=ts.grishin@shlz.ru
FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD=replace_with_a_strong_unique_password

# Required for make up. Replace both values locally; these examples are fictitious.
# One literal value per line; no variable interpolation. See docs/bitrix-startup.md.
FMONITOR_BITRIX_WEBHOOK_URL='https://example.invalid/rest/1/replace_me/'
FMONITOR_BITRIX_DEPARTMENT_IDS_JSON='[101,102]'
